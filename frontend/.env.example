# Base URL of gateway-service, including the /api prefix.
# Local: http://localhost:8080/api
# Production: set this to your deployed gateway URL.
VITE_API_BASE_URL=http://localhost:8080/api

# Browser-reachable MinIO base. Presigned URLs that contain Docker hosts like
# http://minio:9000 are rewritten to this before the browser uploads/downloads.
# Production: set this to your browser-accessible object-storage URL.
VITE_MINIO_PUBLIC_BASE=http://localhost:9000

# Transfer fee in basis points, used only to preview the fee before submitting.
# Must mirror transfers.fee.bps in transfers-service (default 25 = 0.25%).
VITE_TRANSFER_FEE_BPS=25

# Outgoing debits allowed per calendar month on a SAVINGS account.
# Must mirror transfers.savings.max-debits-per-month (default 10).
VITE_SAVINGS_MAX_DEBITS_PER_MONTH=10
