# Allowed browser origins for local frontend development.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: advertised Kafka external host for clients outside Docker.
KAFKA_EXTERNAL_HOST=localhost

# transfers-service AML (docker-compose.apps.yml). Amounts are in cents.
# 5000000 = $50,000 max per transfer; 50 transfers per 10-minute window.
AML_MAX_SINGLE_TRANSFER_CENTS=5000000
AML_VELOCITY_WINDOW_MS=600000
AML_VELOCITY_MAX_COUNT=50
